## Betsafe Finland

# Import Data
bs_fi <- read.csv("bs_fi.csv", header = T)
bs_fi$Date <- dmy(bs_fi$Date)

# seasonal
ts_bs_fi <- ts(bs_fi$Dep_Count, frequency = 52)
